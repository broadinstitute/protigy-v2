# ──────────────────────────────────────────────────────────────────────────
# R / package build artifacts
# ──────────────────────────────────────────────────────────────────────────
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Renviron
.Rproj.user/
*.Rcheck/
*.tar.gz
Rplots.pdf

# RStudio Connect / shinyapps.io deploy metadata
rsconnect/

# Pak lockfiles (optional, platform-specific)
pkg.lock
.github/pkg.lock

# httr2/OAuth token cache (the PELSA UniProt fetch uses httr2; never commit creds)
.httr-oauth

# knitr/R Markdown render caches + figure scratch (vignettes, dev notebooks)
*_cache/
/cache/

# ──────────────────────────────────────────────────────────────────────────
# OS / editor / agent / tooling cruft
# ──────────────────────────────────────────────────────────────────────────
.DS_Store
.cursor/
.claude/
.positai
.worktrees/
firebase-debug.log

# ──────────────────────────────────────────────────────────────────────────
# PELSA reference databases (inst/database/<species>/)
#   TRACKED (inputs users need):   fasta/*.fasta
#   IGNORED (regenerable outputs): the derived feature/membrane caches below,
#   which users rebuild from the FASTA via the Setup page "refresh". The WHOLE
#   uniprot_features/ folder (incl. schema.json) is ignored -- it is regenerated
#   by a Full/Incremental refresh, so it should never be committed.
# ──────────────────────────────────────────────────────────────────────────
inst/database/*/uniprot_features/
inst/database/*/uniprot_membrane/*.tsv
inst/database/*/uniprot_membrane/*.parquet
#   the runtime-generated species classification/display registry (rebuilt on
#   first run; never committed -- see tab_pelsa_species_resolve.R).
inst/database/species_meta.json
#   network-derived validation baselines (dev/ scratch fetch/baseline outputs).
dev/baseline/

# ──────────────────────────────────────────────────────────────────────────
# Local planning / design docs (treated as scratch -- not version-controlled)
# ──────────────────────────────────────────────────────────────────────────
docs/

# ──────────────────────────────────────────────────────────────────────────
# Dev scratch artifacts (regenerable; not source)
#   e.g. volcano visual-diff PNGs from the kaleido consistency check
# ──────────────────────────────────────────────────────────────────────────
dev/*.png

# testthat scratch dir + problems file (created when a test errors mid-run)
tests/testthat/_problems/
tests/testthat/testthat-problems.rds
