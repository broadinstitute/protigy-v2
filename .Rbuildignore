^.*\.Rproj$
^\.Rproj\.user$
^\.github$
^LICENSE\.md$
^app\.R$
^rsconnect$
^dev$
^\.positai$
^\.claude$
^\.Rprofile$
^setup\.R$
# Large PELSA reference FASTAs (~70MB) are kept in the repo (Git LFS) but
# excluded from the built package tarball to stay under CRAN/Bioc size limits.
# Users supply/refresh these via the Setup page; only the .fasta blobs are
# excluded (schema.json and .gitkeep stay tracked and shipped).
^inst/database/[^/]+/fasta/.*\.fasta$
