# NOTE: every line in .Rbuildignore is a Perl regex, so keep these comment lines
# free of unbalanced regex metacharacters.
# PELSA inputs (FASTA + feature annotation file) are uploaded per dataset at
# runtime; the app no longer ships or reads an inst/database/ tree. Exclude any
# stale local contents from the tarball.
^inst/database$
\.DS_Store$
